# ==========================================
# Research & Intelligence Agent
# ==========================================

APP_NAME=Research & Intelligence Agent
APP_ENV=development

# ==========================================
# Local LLM / Ollama
# ==========================================

LLM_PROVIDER=ollama
LLM_MODEL=gemma4:e4b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90

# ==========================================
# Search / SearXNG
# ==========================================

SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_TIMEOUT_SECONDS=30
SEARCH_MAX_RESULTS_PER_QUERY=5

# ==========================================
# Source fetching
# ==========================================

SOURCE_FETCH_TIMEOUT_SECONDS=20
SOURCE_FETCH_MAX_BYTES=1500000
SOURCE_FETCH_MAX_SOURCES_PER_QUESTION=3
